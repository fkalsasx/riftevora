<Window x:Class="SkinForge.UI.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SkinForge.UI.Controls"
        xmlns:loc="clr-namespace:SkinForge.UI.Localization"
        xmlns:vm="clr-namespace:SkinForge.UI.ViewModels"
        xmlns:pages="clr-namespace:SkinForge.UI.Pages"
        Title="Riftevora" Width="1440" Height="900" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontMain}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SearchTrigger" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Height="36" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid Margin="12,0,10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:Icon Data="{StaticResource Icon.Search}" Width="15" Height="15" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{loc:T topbar_search}" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="#0DFFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl K" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter TargetName="Box" Property="Background" Value="#11161D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill.Engine" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="#0D1117" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="-3,0,0,0">
                                    <Ellipse x:Name="Halo" Width="15" Height="15" Fill="{StaticResource SuccessBrush}" Opacity="0.22"/>
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}"/>
                                </Grid>
                                <TextBlock x:Name="PillText" Text="{Binding LtkPill}" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="c:Ui.Compact" Value="True"><Setter TargetName="PillText" Property="Visibility" Value="Collapsed"/></Trigger>
                            <DataTrigger Binding="{Binding LtkReady}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                                <Setter TargetName="Halo" Property="Fill" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/><Setter TargetName="Pill" Property="Background" Value="#141922"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav entry: radio bound to the shell's PageKey -->
        <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
            <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsCompactSidebar}"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
        </Style>

        <Style x:Key="ToastCard" TargetType="Border">
            <Setter Property="Background" Value="#F2151A21"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource ShadowLifted}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ======================= TOPBAR ======================= -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="20">
            <Grid x:Name="TopbarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ActualWidth, ElementName=SidebarHost}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource Btn.Bare}" Command="{Binding NavigateCommand}" CommandParameter="home" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Left" Margin="14,0,0,0" ToolTip="Riftevora">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <Border Width="32" Height="32" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource AccentBorderBrush}" VerticalAlignment="Center">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C232D" Offset="0"/><GradientStop Color="#151A22" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Logo.Hex}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                    <Path Data="{StaticResource Logo.Diamond}" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                                    <Line X1="12" Y1="4.2" X2="12" Y2="20" Stroke="White" StrokeThickness="1"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="BrandText" Text="riftevora" FontSize="13.5" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock Text="/" Foreground="{StaticResource TextDisabledBrush}" FontSize="15" Margin="0,0,8,1"/>
                    <TextBlock Text="{Binding Breadcrumb}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                </StackPanel>

                <Button x:Name="SearchButton" Grid.Column="2" Style="{StaticResource SearchTrigger}" Command="{Binding OpenPaletteCommand}" MaxWidth="460" MinWidth="150" Margin="24,0" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Stretch"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource Pill.Engine}" Command="{Binding NavigateCommand}" CommandParameter="settings" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T tip_engine}"/>
                    <Button Style="{StaticResource Btn.Secondary.Sm}" Command="{Binding ToggleLanguageCommand}" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T tip_language}" Padding="9,6">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Globe}" Width="14" Height="14"/>
                            <TextBlock x:Name="LanguageCode" Text="TR" FontFamily="{StaticResource FontMono}" FontWeight="Bold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Primary.Sm}" Command="{Binding ImportModsCommand}" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" StrokeThickness="2.2"/>
                            <TextBlock x:Name="ImportLabel" Text="{loc:T btn_import_mod}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SidebarToggle" Style="{StaticResource Btn.Icon}" Command="{Binding ToggleSidebarCommand}" Margin="8,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T tip_sidebar}">
                        <c:Icon x:Name="SidebarToggleIcon" Data="{StaticResource Icon.ChevronsLeft}" Width="17" Height="17"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="6,0,0,0">
                    <Button Style="{StaticResource Caption.Button}" c:Ui.Icon="{StaticResource Icon.Minimize}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource Caption.Button}" c:Ui.Icon="{StaticResource Icon.Maximize}" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize"/>
                    <Button Style="{StaticResource Caption.Close}" c:Ui.Icon="{StaticResource Icon.Close}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Style="{StaticResource Progress.Thin}" IsIndeterminate="True" Panel.ZIndex="30"
                     Visibility="{Binding IsBusy, Converter={x:Static c:Conv.Vis}}"/>

        <!-- ======================= BODY ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border x:Name="SidebarHost" Width="208" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Panel.ZIndex="10"
                    c:Ui.Compact="{Binding IsCompactSidebar}">
                <Grid Margin="10,14,10,14">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="SectionExplore" Text="{loc:T nav_section_explore, Upper=True}" Style="{StaticResource Text.Label}" FontSize="10" Margin="12,4,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="{loc:T nav_home}" ToolTip="{loc:T nav_home}" c:Ui.Icon="{StaticResource Icon.Home}" IsChecked="{Binding PageKey, Converter={x:Static c:Conv.Eq}, ConverterParameter=home, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="{loc:T nav_champions}" ToolTip="{loc:T nav_champions}" c:Ui.Icon="{StaticResource Icon.Swords}" c:Ui.Badge="{Binding ChampionsBadge}" IsChecked="{Binding PageKey, Converter={x:Static c:Conv.Eq}, ConverterParameter=champions, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="{loc:T nav_mods}" ToolTip="{loc:T nav_mods}" c:Ui.Icon="{StaticResource Icon.Sparkles}" c:Ui.Badge="{Binding ModsBadge}" IsChecked="{Binding PageKey, Converter={x:Static c:Conv.Eq}, ConverterParameter=mods, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="{loc:T nav_favorites}" ToolTip="{loc:T nav_favorites}" c:Ui.Icon="{StaticResource Icon.Star}" c:Ui.Badge="{Binding FavoritesBadge}" IsChecked="{Binding PageKey, Converter={x:Static c:Conv.Eq}, ConverterParameter=favorites, Mode=TwoWay}"/>

                            <TextBlock x:Name="SectionSystem" Visibility="Collapsed"/>

                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="8,12,8,10"/>
                            <RadioButton Style="{StaticResource NavItem}" Content="{loc:T nav_settings}" ToolTip="{loc:T nav_settings}" c:Ui.Icon="{StaticResource Icon.Sliders}" IsChecked="{Binding PageKey, Converter={x:Static c:Conv.Eq}, ConverterParameter=settings, Mode=TwoWay}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- honest status card -->
                    <Border x:Name="SafetyCard" Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="OnSafetyClick">
                        <StackPanel>
                            <TextBlock Text="{loc:T app_free}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:T app_free_caption}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SafetyTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SafetyText" Text="{Binding SafetyText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- PAGE HOST -->
            <Grid Grid.Column="1" ClipToBounds="True" Background="{StaticResource BgCanvasBrush}">
                <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" IsTabStop="False">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="PageShift"/></ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ======================= OVERLAYS ======================= -->
        <!-- Drawer -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsDrawerOpen, Converter={x:Static c:Conv.Vis}}" Panel.ZIndex="40">
            <Border x:Name="DrawerScrim" Background="{StaticResource ScrimBrush}" MouseLeftButtonDown="OnDrawerScrim"/>
            <Border x:Name="DrawerPanel" Width="580" HorizontalAlignment="Right" Background="{StaticResource BgDrawerBrush}" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1,0,0,0" Effect="{StaticResource ShadowModal}">
                <Border.RenderTransform><TranslateTransform x:Name="DrawerShift"/></Border.RenderTransform>
                <ContentControl Content="{Binding Drawer}" IsTabStop="False"/>
            </Border>
        </Grid>

        <!-- Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsDialogOpen, Converter={x:Static c:Conv.Vis}}" Panel.ZIndex="50">
            <Border Background="#D0070A0E" MouseLeftButtonDown="OnDialogScrim"/>
            <ContentControl x:Name="DialogHost" Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" IsTabStop="False"
                            Style="{StaticResource DialogFrame}" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform><ScaleTransform x:Name="DialogScale"/></ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Lightbox -->
        <pages:LightboxView Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Lightbox}" Visibility="{Binding DataContext.IsLightboxOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static c:Conv.Vis}}" Panel.ZIndex="55"/>

        <!-- Command palette -->
        <Grid x:Name="PaletteLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsPaletteOpen, Converter={x:Static c:Conv.Vis}}" Panel.ZIndex="60">
            <Border Background="#B8070A0E" MouseLeftButtonDown="OnPaletteScrim"/>
            <Border Width="660" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,92,0,0" Background="{StaticResource BgModalBrush}" BorderBrush="{StaticResource BorderBrightBrush}"
                    BorderThickness="1" CornerRadius="12" Effect="{StaticResource ShadowModal}" x:Name="PaletteBox" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform><ScaleTransform x:Name="PaletteScale"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <c:Icon Data="{StaticResource Icon.Search}" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="PaletteInput" Grid.Column="1" Style="{StaticResource Input}" Background="Transparent" BorderThickness="0" Height="58" FontSize="15" Padding="0"
                                 Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}" c:Ui.Hint="{loc:T palette_hint}" PreviewKeyDown="OnPaletteKey" AutomationProperties.Name="{loc:T palette_hint}"/>
                        <Border Grid.Column="2" Background="#0DFFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="ESC" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" MaxHeight="440">
                        <Grid>
                            <TextBlock Text="{loc:T palette_empty}" Style="{StaticResource Text.Sub}" HorizontalAlignment="Center" Margin="0,28" Visibility="{Binding Palette.HasResults, Converter={x:Static c:Conv.InvVis}}"/>
                            <ListBox x:Name="PaletteList" ItemsSource="{Binding Palette.Results}" SelectedIndex="{Binding Palette.SelectedIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False" Style="{StaticResource PaletteListStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Toasts -->
        <ItemsControl x:Name="ToastHost" Grid.Row="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Panel.ZIndex="70" IsTabStop="False" MaxWidth="460">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastItem}">
                    <Border x:Name="Toast" Style="{StaticResource ToastCard}" Margin="0,8,0,0" MinWidth="320">
                        <Grid>
                            <Border x:Name="Edge" Width="3" HorizontalAlignment="Left" CornerRadius="10,0,0,10" Background="{StaticResource InfoBrush}"/>
                            <Grid Margin="16,12,10,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:Icon x:Name="ToastIcon" Data="{StaticResource Icon.Info}" Width="18" Height="18" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Style="{StaticResource Btn.Ghost.Sm}" Content="{Binding ActionLabel}" Command="{Binding DataContext.RunToastActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            HorizontalAlignment="Left" Margin="-10,6,0,-4" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasAction, Converter={x:Static c:Conv.Vis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="26" Height="26" VerticalAlignment="Top" Margin="8,-3,0,0"
                                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Close">
                                    <c:Icon Data="{StaticResource Icon.Close}" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ToneKey}" Value="success">
                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource SuccessBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Data" Value="{StaticResource Icon.Check}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToneKey}" Value="warning">
                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource WarningBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Data" Value="{StaticResource Icon.Warning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToneKey}" Value="error">
                            <Setter TargetName="Edge" Property="Background" Value="{StaticResource DangerBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            <Setter TargetName="ToastIcon" Property="Data" Value="{StaticResource Icon.Warning}"/>
                        </DataTrigger>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                    <ThicknessAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Margin" From="0,26,0,0" To="0,8,0,0" Duration="0:0:0.26">
                                        <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- File drag overlay -->
        <Border Grid.Row="1" Visibility="{Binding IsDragging, Converter={x:Static c:Conv.Vis}}" Panel.ZIndex="80" Background="#D90B0D10" IsHitTestVisible="False" Margin="0">
            <Border Margin="28" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="16" Background="{StaticResource AccentSubtleBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.Import}" Width="48" Height="48" StrokeThickness="1.4" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:T drop_title}" Style="{StaticResource Text.Section}" Margin="0,16,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:T drop_sub}" Style="{StaticResource Text.Sub}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Splash -->
        <Grid x:Name="Splash" Grid.Row="0" Grid.RowSpan="2" Background="#0B0D10" Panel.ZIndex="100" Visibility="{Binding IsSplashVisible, Converter={x:Static c:Conv.Vis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="76" Height="76" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Logo.Hex}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1" StrokeLineJoin="Round" Fill="#12161E"/>
                        <Path Data="{StaticResource Logo.Diamond}" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                        <Line X1="12" Y1="4.2" X2="12" Y2="20" Stroke="White" StrokeThickness="0.8"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="S&#x200A;&#x200A;K&#x200A;&#x200A;I&#x200A;&#x200A;N&#x200A;&#x200A;F&#x200A;&#x200A;O&#x200A;&#x200A;R&#x200A;&#x200A;G&#x200A;&#x200A;E" FontSize="21" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="{loc:T splash_sub, Upper=True}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <ProgressBar Style="{StaticResource Progress.Thin}" IsIndeterminate="True" Width="150" Margin="0,26,0,0" Background="#14FFFFFF"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

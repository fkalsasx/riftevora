<UserControl x:Class="SkinForge.UI.Pages.LightboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization">
    <Grid Background="#F2060809" ClipToBounds="True">
        <Grid x:Name="Stage" Margin="0,64,0,0" Background="Transparent" Cursor="SizeAll"
              MouseWheel="OnWheel" MouseLeftButtonDown="OnDown" MouseLeftButtonUp="OnUp" MouseMove="OnMove" MouseDown="OnMiddle">
            <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5" Margin="40,8,40,40">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="Pan"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <c:RemoteArtwork x:Name="Art" Url="{Binding Url}" Contain="True" FallbackIcon="{StaticResource Icon.Image}" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <Grid Height="64" VerticalAlignment="Top" Background="#CC0B0D10">
            <Grid Margin="28,0,18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{loc:T lightbox_hint}" Style="{StaticResource Text.Small}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomText" Text="100%" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource Btn.Secondary.Sm}" Content="{loc:T lightbox_reset}" Click="OnReset" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding DismissCommand}" ToolTip="{loc:T close}"><c:Icon Data="{StaticResource Icon.Close}" Width="18" Height="18"/></Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

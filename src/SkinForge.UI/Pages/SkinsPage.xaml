<UserControl x:Class="SkinForge.UI.Pages.SkinsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Margin="32,26,32,10">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Page}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,3,0,0"><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Subtitle, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <c:SearchBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Hint="{loc:T skins_search}" Width="300" VerticalAlignment="Center"/>
            </Grid>

            <!-- honesty banner: official skins are artwork, not unlocks -->
            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" CornerRadius="6,0,0,6" Background="{DynamicResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="18,12,18,12">
                        <c:Icon Data="{StaticResource Icon.Shield}" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,14,0"/>
                        <StackPanel>
                            <TextBlock Text="{loc:T skins_banner_title}" FontWeight="Bold" Foreground="White" FontSize="13.5"/>
                            <TextBlock Text="{loc:T skins_banner_text}" Style="{StaticResource Text.Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel>
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="{loc:T filter_all}" IsChecked="{Binding Kind, Converter={x:Static c:Conv.Eq}, ConverterParameter=all, Mode=TwoWay}" GroupName="SkinKind"/>
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="{loc:T filter_skins}" IsChecked="{Binding Kind, Converter={x:Static c:Conv.Eq}, ConverterParameter=skins, Mode=TwoWay}" GroupName="SkinKind"/>
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="{loc:T filter_chromas}" IsChecked="{Binding Kind, Converter={x:Static c:Conv.Eq}, ConverterParameter=chromas, Mode=TwoWay}" GroupName="SkinKind"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="{loc:T sort_by}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Style="{StaticResource Select}" MinWidth="190" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Sort}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <ItemsControl Style="{StaticResource CardGrid}" ItemsSource="{Binding Items}"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={x:Static c:Conv.Vis}}" Margin="0,0,0,80">
                <c:Icon Data="{StaticResource Icon.Search}" Width="38" Height="38" StrokeThickness="1.3" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:T empty_no_results}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="{loc:T empty_no_results_sub}" Style="{StaticResource Text.Sub}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

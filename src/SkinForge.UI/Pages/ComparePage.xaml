<UserControl x:Class="SkinForge.UI.Pages.ComparePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:SkinForge.UI.Controls" xmlns:loc="clr-namespace:SkinForge.UI.Localization">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="36,30,36,30">
  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Page}" FontSize="32"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Sub}" Margin="0,8,0,22"/>
  <Grid Margin="0,0,0,22"><ComboBox Style="{StaticResource Select}" ItemsSource="{Binding Champions}" SelectedItem="{Binding Champion}" DisplayMemberPath="Name" Width="240" HorizontalAlignment="Left" IsTextSearchEnabled="True"/><Button Content="{loc:T compare_swap}" Command="{Binding SwapCommand}" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right"/></Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="{loc:T compare_left}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,12"/><ComboBox Style="{StaticResource Select}" ItemsSource="{Binding Skins}" SelectedItem="{Binding Left}" DisplayMemberPath="Name"/><c:RemoteArtwork Url="{Binding Left.LoadingUrl}" Contain="True" Height="390" Margin="0,16,0,16"/><TextBlock Text="{Binding Left.Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><Button Style="{StaticResource Btn.Secondary}" Content="{loc:T ctx_favorite}" Command="{Binding FavoriteLeftCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="{loc:T compare_right}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,12"/><ComboBox Style="{StaticResource Select}" ItemsSource="{Binding Skins}" SelectedItem="{Binding Right}" DisplayMemberPath="Name"/><c:RemoteArtwork Url="{Binding Right.LoadingUrl}" Contain="True" Height="390" Margin="0,16,0,16"/><TextBlock Text="{Binding Right.Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><Button Style="{StaticResource Btn.Secondary}" Content="{loc:T ctx_favorite}" Command="{Binding FavoriteRightCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>

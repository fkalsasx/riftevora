<UserControl x:Class="SkinForge.UI.Pages.DiscoverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Margin="32,26,32,10">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Page}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,3,0,0"><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Subtitle, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:SearchBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Hint="{loc:T skins_search}" Width="280" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding ShuffleCommand}" Padding="14,8">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Shuffle}" Width="15" Height="15"/><TextBlock Text="{loc:T discover_shuffle}" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <TextBlock Text="{loc:T discover_lines, Upper=True}" Style="{StaticResource Text.Label}" FontSize="10" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Btn.Ghost.Sm}" HorizontalAlignment="Right" Command="{Binding ToggleLinesCommand}" Margin="0,-6,-8,-6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LinesToggleText}" Foreground="{DynamicResource AccentBrush}"/>
                        <c:Icon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Border ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxHeight" Value="38"/>
                        <Style.Triggers><DataTrigger Binding="{Binding LinesExpanded}" Value="True"><Setter Property="MaxHeight" Value="400"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl ItemsSource="{Binding LineChips}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Chip.Button}" Command="{Binding DataContext.PickLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}">
                                <Button.Tag>
                                    <MultiBinding Converter="{x:Static c:Conv.MultiEq}">
                                        <Binding Path="Name"/>
                                        <Binding Path="DataContext.Line" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </MultiBinding>
                                </Button.Tag>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}"/>
                                    <TextBlock Text="{Binding Count}" Margin="7,0,0,0" FontFamily="{StaticResource FontMono}" FontSize="10.5" Opacity="0.6" VerticalAlignment="Center" Visibility="{Binding HasCount, Converter={x:Static c:Conv.Vis}}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <ItemsControl Style="{StaticResource CardGrid}" ItemsSource="{Binding Items}"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={x:Static c:Conv.Vis}}" Margin="0,0,0,80">
                <c:Icon Data="{StaticResource Icon.Search}" Width="38" Height="38" StrokeThickness="1.3" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:T empty_no_results}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="{loc:T empty_no_results_sub}" Style="{StaticResource Text.Sub}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

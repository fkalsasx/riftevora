<UserControl x:Class="SkinForge.UI.Pages.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Margin="32,26,32,10">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Page}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,3,0,0"><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Subtitle, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <c:SearchBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Hint="{loc:T favorites_search}" Width="280" VerticalAlignment="Center"/>
            </Grid>
            <WrapPanel><Button Style="{StaticResource Btn.Secondary.Sm}" Content="{loc:T nav_collections}" Command="{Binding Shell.NavigateCommand}" CommandParameter="collections" Margin="0,0,12,6"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{loc:T filter_all}" IsChecked="{Binding Filter, Converter={x:Static c:Conv.Eq}, ConverterParameter=all, Mode=TwoWay}" GroupName="FavKind"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{loc:T nav_champions}" IsChecked="{Binding Filter, Converter={x:Static c:Conv.Eq}, ConverterParameter=champions, Mode=TwoWay}" GroupName="FavKind"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{loc:T filter_skins}" IsChecked="{Binding Filter, Converter={x:Static c:Conv.Eq}, ConverterParameter=skins, Mode=TwoWay}" GroupName="FavKind"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{loc:T nav_mods}" IsChecked="{Binding Filter, Converter={x:Static c:Conv.Eq}, ConverterParameter=mods, Mode=TwoWay}" GroupName="FavKind"/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <ItemsControl Style="{StaticResource CardGrid}" ItemsSource="{Binding Items}"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={x:Static c:Conv.Vis}}" Margin="0,0,0,80" MaxWidth="440">
                <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.Star}" Width="28" Height="28" StrokeThickness="1.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{loc:T favorites_empty_title}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                <TextBlock Text="{loc:T favorites_empty_text}" Style="{StaticResource Text.Body}" TextAlignment="Center" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding Shell.NavigateCommand}" CommandParameter="discover" Content="{loc:T hero_explore}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

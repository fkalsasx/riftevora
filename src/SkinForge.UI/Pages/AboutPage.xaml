<UserControl x:Class="SkinForge.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,26,32,44" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Page}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Sub}" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource Panel}" Padding="30" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="52" Height="52" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AccentBorderBrush}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C232D" Offset="0"/><GradientStop Color="#151A22" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Viewbox Width="28" Height="28">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Logo.Hex}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                                    <Path Data="{StaticResource Logo.Diamond}" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                                    <Line X1="12" Y1="4.2" X2="12" Y2="20" Stroke="White" StrokeThickness="0.9"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SKINFORGE" FontSize="20" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="{Binding Version}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{loc:T about_text}" Style="{StaticResource Text.Body}" Margin="0,0,0,16"/>
                    <TextBlock Text="{loc:T about_how}" Style="{StaticResource Text.Body}" Margin="0,0,0,18"/>
                    <WrapPanel>
                        <Button Style="{StaticResource Btn.Secondary.Sm}" Command="{Binding OpenLtkRepoCommand}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="LTK Manager"/><c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource Btn.Secondary.Sm}" Command="{Binding OpenRuneforgeCommand}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="Runeforge"/><c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="7,0,0,0"/></StackPanel></Button>
                        <Button Style="{StaticResource Btn.Secondary.Sm}" Command="{Binding OpenDataDragonCommand}" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="Riot Data Dragon"/><c:Icon Data="{StaticResource Icon.External}" Width="13" Height="13" Margin="7,0,0,0"/></StackPanel></Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="30" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{loc:T about_shortcuts}" Style="{StaticResource Text.Section}" Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#0DFFFFFF" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" CornerRadius="5" Padding="9,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource FontMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="30">
                <StackPanel>
                    <TextBlock Text="{loc:T about_legal_title}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:T about_legal}" Style="{StaticResource Text.Sub}" LineHeight="20"/>
                    <TextBlock Text="{Binding Runtime}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

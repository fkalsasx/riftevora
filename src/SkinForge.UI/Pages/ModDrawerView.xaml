<UserControl x:Class="SkinForge.UI.Pages.ModDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization">
    <UserControl.Resources>
        <Style x:Key="KeyLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}"><Setter Property="FontSize" Value="10"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="KeyValue" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Height="250" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B232D" Offset="0"/><GradientStop Color="#0E1217" Offset="1"/></LinearGradientBrush>
            </Grid.Background>
            <c:Icon Data="{StaticResource Icon.Package}" Width="64" Height="64" StrokeThickness="1" Foreground="#2A3442" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <c:RemoteArtwork Url="{Binding PreviewUrl}" FocusY="0.3"/>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.3"/><GradientStop Color="#F00F131A" Offset="1"/></LinearGradientBrush>
                </Border.Background>
            </Border>
            <Button Style="{StaticResource Btn.Overlay}" Padding="0" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Command="{Binding DataContext.CloseDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{loc:T close}"><c:Icon Data="{StaticResource Icon.Close}" Width="16" Height="16"/></Button>
            <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="{Binding FormatText}" Style="{StaticResource Pill.Text}" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <Border Margin="8,0,0,0" Background="{StaticResource WarningSubtleBrush}" CornerRadius="4" Padding="8,2" Visibility="{Binding HasConflicts, Converter={x:Static c:Conv.Vis}}">
                        <TextBlock Text="{loc:T badge_conflict, Upper=True}" Style="{StaticResource Pill.Text}" Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontDisplay}" FontSize="26" FontWeight="ExtraBold" Foreground="White" TextWrapping="Wrap" MaxHeight="70"/>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="#B8C4D2" Margin="0,4,0,0"><Run Text="{Binding Author, Mode=OneWay}"/><Run Text="  ·  v"/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,22,24">
                <Border Style="{StaticResource Panel.Card}" Padding="20,6" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource KeyLabel}" Text="{loc:T mod_key_champions, Upper=True}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource KeyValue}" Text="{Binding ChampionsText}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource KeyLabel}" Text="{loc:T mod_key_files, Upper=True}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyValue}" Text="{Binding FilesText}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource KeyLabel}" Text="{loc:T mod_key_size, Upper=True}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyValue}" Text="{Binding SizeText}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource KeyLabel}" Text="{loc:T mod_key_imported, Upper=True}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyValue}" Text="{Binding ImportedText}"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource KeyLabel}" Text="{loc:T mod_key_format, Upper=True}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource KeyValue}" Text="{Binding FormatText}"/>
                        <TextBlock Grid.Row="5" Style="{StaticResource KeyLabel}" Text="SHA-256"/>
                        <Grid Grid.Row="5" Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource KeyValue}" Text="{Binding HashText}" FontFamily="{StaticResource FontMono}" FontSize="12" ToolTip="{Binding FullHash}"/>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Width="28" Height="28" Command="{Binding CopyHashCommand}" ToolTip="{loc:T copy}"><c:Icon Data="{StaticResource Icon.Copy}" Width="14" Height="14"/></Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Visibility="{Binding HasConflicts, Converter={x:Static c:Conv.Vis}}" Background="#14F59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <c:Icon Data="{StaticResource Icon.Warning}" Width="15" Height="15" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{loc:T mod_conflicts_title, Upper=True}" Style="{StaticResource Text.Label}" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" FontSize="12.5" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="18,14" BorderBrush="{StaticResource BorderBrightBrush}">
                    <StackPanel>
                        <TextBlock Text="{loc:T mod_howto_title}" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:T mod_howto}" Style="{StaticResource Text.Sub}" LineHeight="19"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0B0E13" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding OpenInLtkCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.External}" Width="16" Height="16"/><TextBlock Text="{loc:T btn_open_in_ltk}" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,10,0" ToolTip="{loc:T tip_favorite}" Padding="12,8">
                    <c:Icon x:Name="FavIcon" Data="{StaticResource Icon.Star}" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Btn.Secondary}" Command="{Binding AddToCollectionCommand}" Padding="12,8" ToolTip="{loc:T collection_add_btn}">
                    <c:Icon Data="{StaticResource Icon.Layers}" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource Btn.Secondary}" Command="{Binding ShowFileCommand}" Margin="0,0,10,0" Padding="12,8" ToolTip="{loc:T show_in_folder}">
                    <c:Icon Data="{StaticResource Icon.Folder}" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>
        <Button Grid.Row="2" Style="{StaticResource Btn.Danger}" Command="{Binding RemoveCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" Padding="12,8" ToolTip="{loc:T remove_confirm}">
            <c:Icon Data="{StaticResource Icon.Trash}" Width="16" Height="16"/>
        </Button>
    </Grid>
</UserControl>

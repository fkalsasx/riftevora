<UserControl x:Class="SkinForge.UI.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Margin="32,26,32,10">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Page}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,3,0,0"><Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding TotalSizeText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Subtitle, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Secondary}" Command="{Binding Shell.FindModsCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{loc:T mods_find}"/><c:Icon Data="{StaticResource Icon.External}" Width="14" Height="14" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Secondary}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0" ToolTip="{loc:T mods_open_folder}">
                        <c:Icon Data="{StaticResource Icon.Folder}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding ImportCommand}">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Plus}" Width="15" Height="15" StrokeThickness="2.2"/><TextBlock Text="{loc:T btn_import_mod}" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- LTK missing banner -->
            <Border Visibility="{Binding LtkMissing, Converter={x:Static c:Conv.Vis}}" Background="#14F59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <c:Icon Data="{StaticResource Icon.Warning}" Width="18" Height="18" Foreground="{StaticResource WarningBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T mods_ltk_missing_title}" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{loc:T mods_ltk_missing_text}" Style="{StaticResource Text.Sub}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Secondary.Sm}" Command="{Binding Shell.NavigateCommand}" CommandParameter="settings" Content="{loc:T ltk_setup_action}"/>
                </Grid>
            </Border>

            <Grid Visibility="{Binding HasAnyPackages, Converter={x:Static c:Conv.Vis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:SearchBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" c:Ui.Hint="{loc:T mods_search}" Width="320" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{loc:T sort_by}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Style="{StaticResource Select}" MinWidth="170" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Sort}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <ItemsControl Style="{StaticResource CardGrid}" ItemsSource="{Binding Items}" Visibility="{Binding HasAnyPackages, Converter={x:Static c:Conv.Vis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:VirtualGridPanel MinItemWidth="268" AspectRatio="0.58" ExtraHeight="82" Gap="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- empty library -->
            <Border Visibility="{Binding HasAnyPackages, Converter={x:Static c:Conv.InvVis}}" Margin="32,10,32,40" CornerRadius="14" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="2" MaxWidth="900" VerticalAlignment="Center" Padding="40,44">
                <Border.Background>
                    <DrawingBrush Viewport="0,0,12,12" ViewportUnits="Absolute" TileMode="Tile" Opacity="0.55">
                        <DrawingBrush.Drawing><GeometryDrawing Brush="#09FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="6,6" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.Import}" Width="30" Height="30" StrokeThickness="1.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{loc:T mods_empty_title}" Style="{StaticResource Text.Section}" FontSize="21" HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBlock Text="{loc:T mods_empty_text}" Style="{StaticResource Text.Body}" TextAlignment="Center" MaxWidth="520" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding ImportCommand}" Content="{loc:T btn_import_mod_long}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource Btn.Secondary}" Command="{Binding Shell.FindModsCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{loc:T mods_find}"/><c:Icon Data="{StaticResource Icon.External}" Width="14" Height="14" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{loc:T mods_formats}" Style="{StaticResource Text.Label}" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80">
                <StackPanel.Visibility>
                    <MultiBinding Converter="{x:Static c:Conv.AndVis}">
                        <Binding Path="IsEmpty"/><Binding Path="HasAnyPackages"/>
                    </MultiBinding>
                </StackPanel.Visibility>
                <c:Icon Data="{StaticResource Icon.Search}" Width="38" Height="38" StrokeThickness="1.3" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:T empty_no_results}" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="{loc:T empty_no_results_sub}" Style="{StaticResource Text.Sub}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

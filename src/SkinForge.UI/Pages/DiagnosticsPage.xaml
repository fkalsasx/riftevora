<UserControl x:Class="SkinForge.UI.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SkinForge.UI.Controls"
             xmlns:loc="clr-namespace:SkinForge.UI.Localization"
             xmlns:vm="clr-namespace:SkinForge.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,26,32,44" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Page}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Sub}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Secondary}" Command="{Binding ClearCacheCommand}" Content="{loc:T diag_clear_cache}" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding RunCommand}" IsEnabled="{Binding IsRunning, Converter={x:Static c:Conv.Not}}">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Activity}" Width="15" Height="15"/><TextBlock Text="{loc:T diag_run}" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- verdict -->
            <Border Padding="24,20" Margin="0,0,0,18">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SummaryKey}" Value="warning"><Setter Property="BorderBrush" Value="#59F59E0B"/></DataTrigger>
                            <DataTrigger Binding="{Binding SummaryKey}" Value="fail"><Setter Property="BorderBrush" Value="#59EF4444"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#14FFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SummaryKey}" Value="ok"><Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SummaryKey}" Value="warning"><Setter Property="Background" Value="{StaticResource WarningSubtleBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SummaryKey}" Value="fail"><Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <c:Icon Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:Icon.Style>
                                <Style TargetType="c:Icon">
                                    <Setter Property="Data" Value="{StaticResource Icon.Activity}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryKey}" Value="ok"><Setter Property="Data" Value="{StaticResource Icon.Shield}"/><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SummaryKey}" Value="warning"><Setter Property="Data" Value="{StaticResource Icon.Warning}"/><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SummaryKey}" Value="fail"><Setter Property="Data" Value="{StaticResource Icon.Warning}"/><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Icon.Style>
                        </c:Icon>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SummaryTitle}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Sub}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Visibility="{Binding IsRunning, Converter={x:Static c:Conv.Vis}}">
                        <Run Text="{Binding Progress, StringFormat=P0, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- checks -->
            <Border Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DiagnosticRow}">
                                <Border x:Name="Row" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="22,14" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource TextDisabledBrush}"/>
                                            <c:Icon x:Name="Mark" Width="18" Height="18" StrokeThickness="2.2" Visibility="Collapsed" Data="{StaticResource Icon.Check}" Foreground="{StaticResource SuccessBrush}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DetailText" Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Text.Sub}" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                        <Button Grid.Column="3" Style="{StaticResource Btn.Secondary.Sm}" Content="{Binding FixLabel}" Visibility="{Binding FixId, Converter={x:Static c:Conv.NullCollapsed}}"
                                                Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding StatusKey}" Value="pending">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
                                        <Setter TargetName="DetailText" Property="Text" Value="…"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKey}" Value="ok"><Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKey}" Value="info">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Info}"/><Setter TargetName="Mark" Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKey}" Value="warning">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Warning}"/><Setter TargetName="Mark" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKey}" Value="fail">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Warning}"/><Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Setter TargetName="DetailText" Property="Foreground" Value="#F87171"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- scanner line -->
                    <Rectangle x:Name="ScannerLine" Height="2" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/><GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform><TranslateTransform x:Name="ScannerShift"/></Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

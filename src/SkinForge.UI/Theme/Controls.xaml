<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SkinForge.UI.Controls">

    <!-- ================= TYPOGRAPHY ================= -->
    <Style x:Key="Text.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="42"/>
    </Style>
    <Style x:Key="Text.Page" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Text.Card" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="Text.Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Text.Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style x:Key="Text.Accent" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ================= SURFACES ================= -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="Panel.Card" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
    </Style>

    <!-- ================= FOCUS ================= -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= BUTTONS ================= -->
    <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True">
            <Border.RenderTransform><TranslateTransform x:Name="Shift"/></Border.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.14"/></VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.11" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.42" Duration="0"/></Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
                <Border x:Name="Wash" Background="White" Opacity="0" CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False"/>
                <Border x:Name="Press" Background="Black" Opacity="0" CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False"/>
                <Border x:Name="Ring" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" Opacity="0" CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn}"/>
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Foreground" Value="#0B0D10"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="#4DEF4444"/>
        <Setter Property="Foreground" Value="#F87171"/>
    </Style>
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
    </Style>
    <Style x:Key="Btn.Primary.Sm" TargetType="Button" BasedOn="{StaticResource Btn.Primary}"><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Btn.Secondary.Sm" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}"><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Btn.Ghost.Sm" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}"><Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Btn.Danger.Sm" TargetType="Button" BasedOn="{StaticResource Btn.Danger}"><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Btn.Overlay" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="#B80B0D10"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Bare button: no chrome, used to make a whole card clickable -->
    <Style x:Key="Btn.Bare" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= CHIPS (filters) ================= -->
    <ControlTemplate x:Key="ChipTemplate" TargetType="ToggleButton">
        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="Wash" Background="White" Opacity="0" CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.07"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource ChipTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <ControlTemplate x:Key="ChipRadioTemplate" TargetType="RadioButton">
        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="Wash" Background="White" Opacity="0" CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.07"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Chip.Radio" TargetType="RadioButton">
        <Setter Property="Template" Value="{StaticResource ChipRadioTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Chip as a plain Button: "selected" comes from Tag, so a list of chips can be driven by a MultiBinding without fighting toggle logic -->
    <Style x:Key="Chip.Button" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Wash" Background="White" Opacity="0" CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.07"/></Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings tabs: full-width left aligned -->
    <Style x:Key="Tab.Radio" TargetType="RadioButton" BasedOn="{StaticResource Chip.Radio}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ================= SIDEBAR NAV ITEM ================= -->
    <ControlTemplate x:Key="NavTemplate" TargetType="RadioButton">
        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" Height="38" Margin="0,0,0,2" ToolTipService.InitialShowDelay="200">
            <Border x:Name="Active" Background="{StaticResource BgActiveNavBrush}" CornerRadius="{StaticResource RadiusSm}" Opacity="0"/>
            <Border x:Name="Wash" Background="White" Opacity="0" CornerRadius="{StaticResource RadiusSm}" IsHitTestVisible="False"/>
            <Border x:Name="Bar" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="0,3,3,0" Background="{DynamicResource AccentBrush}" Opacity="0" Margin="0,0,0,0">
                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource AccentGlowColor}" Opacity="1"/></Border.Effect>
            </Border>
            <Grid x:Name="Inner" Margin="12,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <c:Icon x:Name="Glyph" Data="{TemplateBinding c:Ui.Icon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ContentPresenter x:Name="Label" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextElement.FontSize="13" TextElement.FontWeight="Medium"/>
                <Border x:Name="BadgeHost" Grid.Column="2" Background="#0FFFFFFF" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText" Text="{TemplateBinding c:Ui.Badge}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Badge" Value="{x:Null}"><Setter TargetName="BadgeHost" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="c:Ui.Badge" Value=""><Setter TargetName="BadgeHost" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Wash" Property="Opacity" Value="0.045"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Active" Property="Opacity" Value="1"/>
                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                <Setter TargetName="BadgeHost" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="c:Ui.Compact" Value="True">
                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="BadgeHost" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Inner" Property="Margin" Value="0"/>
                <Setter TargetName="Glyph" Property="Grid.ColumnSpan" Value="3"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Template" Value="{StaticResource NavTemplate}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="GroupName" Value="Nav"/>
    </Style>

    <!-- ================= TEXT INPUT ================= -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSm}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding c:Ui.Hint}" Margin="{TemplateBinding Padding}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="{DynamicResource AccentGlowColor}"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= SEARCH BOX ================= -->
    <Style TargetType="c:SearchBox">
        <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SearchBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}">
                        <Grid>
                            <c:Icon Data="{StaticResource Icon.Search}" Width="15" Height="15" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="38,0,32,0" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding c:Ui.Hint}" Margin="38,0,32,0" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="PART_Clear" HorizontalAlignment="Right" Margin="0,0,6,0" Width="22" Height="22" Cursor="Hand" Focusable="False" Foreground="{StaticResource TextMutedBrush}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent"><c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" StrokeThickness="2"/></Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/><Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Root" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" Color="{DynamicResource AccentGlowColor}"/></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= SWITCH ================= -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#26FFFFFF" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbShift"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#0B0D10"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= WINDOW CAPTION ================= -->
    <Style x:Key="Caption.Button" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

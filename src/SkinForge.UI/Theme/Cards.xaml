<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SkinForge.UI.Controls"
                    xmlns:loc="clr-namespace:SkinForge.UI.Localization"
                    xmlns:vm="clr-namespace:SkinForge.UI.ViewModels">

    <!-- ===== Pill used for badges on art (format, role, chroma) ===== -->
    <Style x:Key="Pill.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Background" Value="#CC0B0D10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Badge}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding BadgeTone}" Value="info">
                <Setter Property="BorderBrush" Value="#5938BDF8"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Pill.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="FavButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="#D6DCE4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Background="#B80B0D10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <c:Icon x:Name="Glyph" Data="{StaticResource Icon.Star}" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Champion and skin portrait card ===== -->
    <DataTemplate x:Key="PortraitCard" DataType="{x:Type vm:CardItem}">
        <Grid x:Name="Root" Margin="0" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{loc:T ctx_open}" Command="{Binding PlacementTarget.Tag.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Eye}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{loc:T ctx_favorite}" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Star}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{loc:T ctx_collection}" Command="{Binding PlacementTarget.Tag.AddToCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Layers}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
              </ContextMenu>
            </Grid.ContextMenu>
            <Border x:Name="Card" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
                    RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Button Style="{StaticResource Btn.Bare}" Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
                        <Grid ClipToBounds="True">
                            <c:RemoteArtwork Url="{Binding ImageUrl}" FocusY="{Binding FocusY}" FallbackIcon="{StaticResource Icon.Image}"/>
                            <Border Background="{StaticResource CardArtScrim}"/>
                            <Border Style="{StaticResource Pill.Badge}" Margin="10,10,0,0"><TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Badge}"/></Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="14,8,14,10" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Card}" Text="{Binding Title}" ToolTip="{Binding Title}"/>
                            <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Subtitle}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MetaLine" Style="{StaticResource Text.Label}" Text="{Binding Meta}" Margin="0,4,0,0" FontWeight="Normal" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Border>
            <Button x:Name="Fav" Style="{StaticResource FavButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Opacity="0"
                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{loc:T tip_favorite}" AutomationProperties.Name="{loc:T tip_favorite}"/>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Fav" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.16"/>
                    </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                <Setter TargetName="Fav" Property="Opacity" Value="1"/>
                <Setter TargetName="Fav" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Mod package card ===== -->
    <DataTemplate x:Key="ModCard" DataType="{x:Type vm:CardItem}">
        <Grid x:Name="Root" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{loc:T ctx_open}" Command="{Binding PlacementTarget.Tag.OpenCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Eye}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{loc:T ctx_open_ltk}" Command="{Binding PlacementTarget.Tag.OpenInLtkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.External}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{loc:T ctx_favorite}" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Star}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{loc:T ctx_collection}" Command="{Binding PlacementTarget.Tag.AddToCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Layers}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="{loc:T ctx_show_file}" Command="{Binding PlacementTarget.Tag.ShowCardInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Folder}" Width="15" Height="15"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="{loc:T ctx_remove}" Command="{Binding PlacementTarget.Tag.RemoveModCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"><MenuItem.Icon><c:Icon Data="{StaticResource Icon.Trash}" Width="15" Height="15" Foreground="#F87171"/></MenuItem.Icon></MenuItem>
              </ContextMenu>
            </Grid.ContextMenu>
            <Border x:Name="Card" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
                    RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Button Style="{StaticResource Btn.Bare}" Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
                        <Grid ClipToBounds="True">
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B232D" Offset="0"/><GradientStop Color="#10151B" Offset="1"/></LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <c:Icon Data="{StaticResource Icon.Package}" Width="40" Height="40" StrokeThickness="1.2" Foreground="#2F3A49" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <c:RemoteArtwork Url="{Binding ImageUrl}" FocusY="{Binding FocusY}"/>
                            <Border Background="{StaticResource CardArtScrim}"/>
                            <Border Style="{StaticResource Pill.Badge}" Margin="10,10,0,0"><TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Badge}"/></Border>
                            <Border x:Name="ConflictPill" Visibility="Collapsed" Margin="0,10,50,0" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4" Padding="6,2"
                                    Background="#CC0B0D10" BorderBrush="#66F59E0B" BorderThickness="1" ToolTip="{loc:T mod_conflict_tip}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Warning}" Width="11" Height="11" StrokeThickness="2" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock Style="{StaticResource Pill.Text}" Text="{loc:T badge_conflict, Upper=True}" Foreground="{StaticResource WarningBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- hover: primary action straight on the card -->
                            <Border x:Name="Hover" Background="#C20B0D10" Opacity="0" IsHitTestVisible="False">
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource Icon.External}" Width="14" Height="14" Foreground="#0B0D10" StrokeThickness="2"/>
                                        <TextBlock Text="{loc:T btn_open_in_ltk}" Foreground="#0B0D10" FontWeight="Bold" FontSize="12.5" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="14,8,14,10" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Card}" Text="{Binding Title}" ToolTip="{Binding Title}"/>
                            <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Subtitle}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            <Grid Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Meta}" FontWeight="Normal" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="{StaticResource AccentSubtleBrush}" CornerRadius="4" Padding="6,1" Visibility="{Binding Badge2, Converter={x:Static c:Conv.NullCollapsed}}">
                                    <TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Badge2}" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>
            </Border>
            <Button x:Name="Fav" Style="{StaticResource FavButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Opacity="0"
                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{loc:T tip_favorite}" AutomationProperties.Name="{loc:T tip_favorite}"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasConflict}" Value="True"><Setter TargetName="ConflictPill" Property="Visibility" Value="Visible"/></DataTrigger>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Fav" Property="Opacity" Value="1"/>
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.16"/>
                    </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                <Setter TargetName="Fav" Property="Opacity" Value="1"/>
                <Setter TargetName="Fav" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Collection card: 2x2 mosaic ===== -->
    <DataTemplate x:Key="CollectionCard" DataType="{x:Type vm:CardItem}">
        <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Card" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Button Style="{StaticResource Btn.Bare}" Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
                        <Grid Background="#0F1318">
                            <ItemsControl ItemsSource="{Binding Mosaic}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding DataContext.MosaicColumns, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><c:RemoteArtwork Url="{Binding}" FocusY="0.12"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:Icon Data="{StaticResource Icon.Layers}" Width="34" Height="34" StrokeThickness="1.2" Foreground="#2F3A49" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Mosaic.Count, Converter={x:Static c:Conv.ZeroVisible}}"/>
                            <Border Background="{StaticResource CardArtScrim}"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="14,8,14,10" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Card}" Text="{Binding Title}"/>
                            <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Subtitle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Compact table row for champions ===== -->
    <DataTemplate x:Key="ChampionRow" DataType="{x:Type vm:CardItem}">
        <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Row" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                <Button Style="{StaticResource Btn.Bare}" Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Grid Margin="12,0,56,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left"><c:RemoteArtwork Url="{Binding ImageUrl}" FocusY="0.08"/></Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Card}" Text="{Binding Title}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Small}" Text="{Binding Subtitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                        <Border Grid.Column="3" Style="{StaticResource Pill.Badge}" VerticalAlignment="Center"><TextBlock Style="{StaticResource Pill.Text}" Text="{Binding Badge}"/></Border>
                        <TextBlock Grid.Column="4" Style="{StaticResource Text.Label}" Text="{Binding Count}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                </Button>
            </Border>
            <Button x:Name="Fav" Style="{StaticResource FavButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0"
                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                <Setter TargetName="Row" Property="Background" Value="{StaticResource BgCardBrush}"/>
                <Setter TargetName="Fav" Property="Opacity" Value="1"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter TargetName="Fav" Property="Opacity" Value="1"/><Setter TargetName="Fav" Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <c:CardTemplateSelector x:Key="CardSelector" Portrait="{StaticResource PortraitCard}" Mod="{StaticResource ModCard}" Collection="{StaticResource CollectionCard}"/>

    <!-- ===== Virtualized card grid: used by every catalog page ===== -->
    <Style x:Key="CardGrid" TargetType="ItemsControl">
        <Setter Property="ItemTemplateSelector" Value="{StaticResource CardSelector}"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="32,6,20,32"/>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><c:VirtualGridPanel MinItemWidth="208" AspectRatio="1.2" ExtraHeight="82" Gap="16"/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="PART_Scroll" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

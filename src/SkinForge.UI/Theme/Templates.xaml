<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SkinForge.UI.Controls"
                    xmlns:loc="clr-namespace:SkinForge.UI.Localization"
                    xmlns:vm="clr-namespace:SkinForge.UI.ViewModels"
                    xmlns:pages="clr-namespace:SkinForge.UI.Pages">

    <!-- ================= PAGES ================= -->
    <DataTemplate DataType="{x:Type vm:CompareViewModel}"><pages:ComparePage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><pages:HomePage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiscoverViewModel}"><pages:DiscoverPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChampionsViewModel}"><pages:ChampionsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SkinsViewModel}"><pages:SkinsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModsViewModel}"><pages:ModsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CollectionsViewModel}"><pages:CollectionsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FavoritesViewModel}"><pages:FavoritesPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ToolsViewModel}"><pages:ToolsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><pages:DiagnosticsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BackupViewModel}"><pages:BackupPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><pages:AboutPage/></DataTemplate>

    <!-- ================= DRAWERS ================= -->
    <DataTemplate DataType="{x:Type vm:ChampionDrawer}"><pages:ChampionDrawerView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ModDrawer}"><pages:ModDrawerView/></DataTemplate>

    <!-- ================= DIALOG FRAME ================= -->
    <Style x:Key="DialogFrame" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Margin="40" Background="{StaticResource BgModalBrush}" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource ShadowModal}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,15,14,13">
                                <Grid>
                                    <TextBlock Text="{Binding Content.Title, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Text.Section}" FontSize="16" VerticalAlignment="Center" Margin="0,0,40,0" TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right" Width="30" Height="30" Command="{Binding Content.DismissCommand, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="Close">
                                        <c:Icon Data="{StaticResource Icon.Close}" Width="15" Height="15"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Confirm ===== -->
    <DataTemplate DataType="{x:Type vm:ConfirmDialog}">
        <StackPanel Width="460" Margin="24,20,24,22">
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource Btn.Secondary}" Content="{loc:T cancel}" Command="{Binding DismissCommand}" Margin="0,0,10,0" c:Ui.AutoFocus="True"/>
                <Button x:Name="Go" Style="{StaticResource Btn.Primary}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDanger}" Value="True"><Setter TargetName="Go" Property="Style" Value="{StaticResource Btn.Danger}"/></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Prompt ===== -->
    <DataTemplate DataType="{x:Type vm:PromptDialog}">
        <StackPanel Width="460" Margin="24,20,24,22">
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Margin="0,0,0,14" Visibility="{Binding Message, Converter={x:Static c:Conv.NullCollapsed}}"/>
            <TextBox Style="{StaticResource Input}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" c:Ui.Hint="{Binding Hint}" c:Ui.AutoFocus="True" MaxLength="60">
                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding ConfirmCommand}"/></TextBox.InputBindings>
            </TextBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource Btn.Secondary}" Content="{loc:T cancel}" Command="{Binding DismissCommand}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource Btn.Primary}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Risk consent ===== -->
    <DataTemplate DataType="{x:Type vm:RiskDialog}">
        <StackPanel Width="560" Margin="24,20,24,22">
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,14"><Run Text="{loc:T risk_target}"/> <Run Text="{Binding Target, Mode=OneWay}" FontWeight="Bold" Foreground="White"/></TextBlock>
            <Border Background="#14F59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <c:Icon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="{loc:T risk_heading, Upper=True}" Style="{StaticResource Text.Label}" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{loc:T risk_body}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20"/>
                </StackPanel>
            </Border>
            <StackPanel Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="{loc:T risk_point_1}" Style="{StaticResource Text.Sub}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="480"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="{loc:T risk_point_2}" Style="{StaticResource Text.Sub}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="480"/></StackPanel>
                <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="{loc:T risk_point_3}" Style="{StaticResource Text.Sub}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="480"/></StackPanel>
            </StackPanel>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Understood, Mode=TwoWay}" Content="{loc:T risk_ack}" FontWeight="Medium" Margin="0,0,0,22"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Content="{loc:T cancel}" Command="{Binding DismissCommand}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource Btn.Primary}" Content="{loc:T risk_continue}" Command="{Binding AcceptCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Import ===== -->
    <DataTemplate DataType="{x:Type vm:ImportDialog}">
        <StackPanel Width="640" Margin="24,20,24,22">
            <ItemsControl ItemsSource="{Binding Items}" MaxHeight="340">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ImportItem}">
                        <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <c:Icon x:Name="Glyph" Data="{StaticResource Icon.Package}" Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Card}"/>
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}"/>
                                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" Background="#14FFFFFF">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid><Border Background="{TemplateBinding Background}" CornerRadius="1.5"/><Border x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5"/></Border></Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <TextBlock x:Name="ErrorText" Text="{Binding Error}" Style="{StaticResource Text.Sub}" Foreground="#F87171" Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Check}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Warning}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Setter TargetName="StatusText" Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" Visibility="{Binding Finished, Converter={x:Static c:Conv.Vis}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" Visibility="{Binding Finished, Converter={x:Static c:Conv.Vis}}">
                <Button Style="{StaticResource Btn.Secondary}" Content="{loc:T close}" Command="{Binding DismissCommand}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource Btn.Primary}" Content="{loc:T import_open_library}" Command="{Binding OpenLibraryCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===== Add to collection ===== -->
    <DataTemplate DataType="{x:Type vm:CollectionPickerDialog}">
        <StackPanel Width="480" Margin="24,20,24,22">
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,14" Text="{Binding ItemTitle}" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="{loc:T collection_none_yet}" Style="{StaticResource Text.Sub}" Margin="0,0,0,12" Visibility="{Binding HasChoices, Converter={x:Static c:Conv.InvVis}}"/>
            <ItemsControl ItemsSource="{Binding Choices}" MaxHeight="260">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CollectionChoice}">
                        <Button x:Name="Row" Style="{StaticResource Btn.Secondary}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="14,10"
                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Count}" Style="{StaticResource Text.Small}"/></StackPanel>
                                <c:Icon x:Name="Tick" Grid.Column="1" Data="{StaticResource Icon.Check}" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" StrokeThickness="2.4" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMember}" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource Input}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" c:Ui.Hint="{loc:T collection_name_hint}" MaxLength="60">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding CreateCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Content="{loc:T collection_create}" Command="{Binding CreateCommand}" Margin="10,0,0,0"/>
            </Grid>
            <Button Style="{StaticResource Btn.Secondary}" Content="{loc:T close}" Command="{Binding DismissCommand}" HorizontalAlignment="Right" Margin="0,18,0,0"/>
        </StackPanel>
    </DataTemplate>

    <!-- ===== First-run setup ===== -->
    <DataTemplate DataType="{x:Type vm:SetupDialog}">
        <StackPanel Width="600" Margin="24,20,24,22">
            <TextBlock Text="{loc:T setup_headline}" Style="{StaticResource Text.Section}" FontSize="19" Margin="0,0,0,4"/>
            <TextBlock Text="{loc:T setup_intro}" Style="{StaticResource Text.Body}" Margin="0,0,0,18"/>

            <Border Style="{StaticResource Panel}" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:T setup_ltk}" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding LtkDetail}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="LtkTag" CornerRadius="4" Padding="9,3" Background="{StaticResource WarningSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="LtkTagText" Text="{loc:T setup_missing, Upper=True}" Style="{StaticResource Pill.Text}" Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource Panel}" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:T setup_game}" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding GameDetail}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="GameTag" CornerRadius="4" Padding="9,3" Background="{StaticResource WarningSubtleBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="GameTagText" Text="{loc:T setup_missing, Upper=True}" Style="{StaticResource Pill.Text}" Foreground="{StaticResource WarningBrush}"/>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="{loc:T setup_note}" Style="{StaticResource Text.Sub}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Shell.SetupStatus}" Style="{StaticResource Text.Sub}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Shell.HasSetupStatus, Converter={x:Static c:Conv.Vis}}"/>
            <ProgressBar Value="{Binding Shell.SetupPercent}" Maximum="100" Height="4" Margin="0,10,0,0" Visibility="{Binding Shell.IsSetupBusy, Converter={x:Static c:Conv.Vis}}"/>

            <WrapPanel Margin="0,22,0,0">
                <Button Style="{StaticResource Btn.Primary}" Content="{loc:T setup_add_game}" Command="{Binding Shell.AddGameCommand}" Margin="0,0,8,8"/>
                <Button Style="{StaticResource Btn.Secondary.Sm}" Content="{loc:T setup_recheck}" Command="{Binding RecheckCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Secondary.Sm}" Content="{loc:T setup_choose_ltk}" Command="{Binding ChooseLtkFileCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Ghost.Sm}" Content="{loc:T setup_download}" Command="{Binding Shell.DownloadLtkCommand}"/>
                <Button Style="{StaticResource Btn.Ghost.Sm}" Command="{Binding Shell.CancelSetupCommand}" Content="{loc:T cancel}" Visibility="{Binding Shell.SetupCanCancel, Converter={x:Static c:Conv.Vis}}"/>
                <Button Style="{StaticResource Btn.Primary}" Content="{loc:T setup_start}" Command="{Binding FinishCommand}" HorizontalAlignment="Right" Margin="40,0,0,0"/>
            </WrapPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding LtkReady}" Value="True">
                <Setter TargetName="LtkTag" Property="Background" Value="{StaticResource SuccessSubtleBrush}"/>
                <Setter TargetName="LtkTagText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                <Setter TargetName="LtkTagText" Property="Text" Value="{loc:T setup_ready, Upper=True}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding GameReady}" Value="True">
                <Setter TargetName="GameTag" Property="Background" Value="{StaticResource SuccessSubtleBrush}"/>
                <Setter TargetName="GameTagText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                <Setter TargetName="GameTagText" Property="Text" Value="{loc:T setup_found, Upper=True}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= COMMAND PALETTE LIST ================= -->
    <Style x:Key="PaletteListStyle" TargetType="ListBox">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <StackPanel>
                                    <TextBlock Text="{Binding Group}" Style="{StaticResource Text.Label}" Margin="10,12,0,6" Visibility="{Binding ShowHeader, Converter={x:Static c:Conv.Vis}}"/>
                                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                      <Button Style="{StaticResource Btn.Bare}" Command="{Binding DataContext.Palette.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <Grid Margin="10,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="7" Background="#0FFFFFFF" ClipToBounds="True" HorizontalAlignment="Left">
                                                <Grid>
                                                    <c:Icon Data="{Binding Icon}" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding HasImage, Converter={x:Static c:Conv.InvVis}}"/>
                                                    <c:RemoteArtwork Url="{Binding ImageUrl}" FocusY="0.1" Visibility="{Binding HasImage, Converter={x:Static c:Conv.Vis}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" Visibility="{Binding Subtitle, Converter={x:Static c:Conv.NullCollapsed}}"/>
                                            </StackPanel>
                                            <c:Icon x:Name="Enter" Grid.Column="2" Data="{StaticResource Icon.Arrow}" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" Opacity="0" VerticalAlignment="Center"/>
                                        </Grid>
                                      </Button>
                                    </Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                        <Setter TargetName="Enter" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger SourceName="Bd" Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
